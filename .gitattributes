# Normalisasi line ending lintas platform.
# Disimpan di repo dengan LF, checkout di Windows boleh CRLF.
* text=auto eol=lf

# Berkas teks
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# Aset biner — jangan diubah baris berakhirnya
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
