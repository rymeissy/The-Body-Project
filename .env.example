# Salin file ini jadi .env lalu isi nilainya.
#   cp .env.example .env      (Windows: copy .env.example .env)
# .env sudah masuk .gitignore, jadi nilainya tidak ikut ter-commit.

# Token Fonnte — dashboard md.fonnte.com → Device → Token.
# Kosongkan untuk mode demo: OTP tidak dikirim, kodenya tampil di layar saja.
FONNTE_TOKEN=

# Kunci penandatangan token sesi. Ganti dengan string acak yang panjang.
TOKEN_SECRET=

# Koneksi PostgreSQL. Nilai bawaan ini untuk db/docker-compose.yml.
PGHOST=localhost
PGPORT=5434
PGDATABASE=the_body_project
PGUSER=tbp
PGPASSWORD=tbp_dev_password